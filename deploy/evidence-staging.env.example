# Documented staging-only variables — templates, NEVER commit working secrets.
# This file is not sourced by production or deployed automatically.
CFA_RUNTIME_MODE=selfhost
CFA_PUBLIC_BETA_LOCK=1
CFA_ALLOW_ANONYMOUS_SELFHOST=0
CFA_SEED_DEMO=0
CFA_DATA_DIR=/app/data
CFA_REMOTE_MCP_ENABLED=1
CFA_REMOTE_MCP_DEV=0
CFA_WEB_APP_URL=https://REPLACE-WITH-ISOLATED-STAGING.up.railway.app
# Configure only a dedicated, tested staging SMTP account in Railway variables:
CFA_SMTP_HOST=
CFA_SMTP_PORT=465
CFA_SMTP_USER=
CFA_SMTP_PASSWORD=
CFA_MAIL_FROM=
# Deliberately leave Telegram bot/ATS production credentials UNSET.
# Use a GitHub-tested immutable commit, not moving main or production:
ROLEHINT_EXPECTED_RELEASE_SHA=
